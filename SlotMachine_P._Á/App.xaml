<Application x:Class="SlotMachine_P._Á.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SlotMachine_P._Á"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

            <!-- 🎨 Színek -->
            <Color x:Key="BgDark">#1E1E1E</Color>
            <Color x:Key="Gold">#FFD700</Color>
            <Color x:Key="Green">#2ECC71</Color>
            <Color x:Key="LightText">#F5F5F5</Color>

            <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDark}"/>
            <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}"/>
            <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource Green}"/>
            <SolidColorBrush x:Key="LightTextBrush" Color="{StaticResource LightText}"/>

            <!-- 🪟 Window -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BgDarkBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
            </Style>

            <!-- 📝 TextBlock -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <!-- ⭐ Kiemelt szöveg (pl. eredmény) -->
            <Style x:Key="ResultTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>

            <!-- 🔘 Button -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                            CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 🔘 RadioButton -->
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
                <Setter Property="Margin" Value="5"/>
            </Style>

            <!-- ☑ CheckBox -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
                <Setter Property="Margin" Value="5"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
