<Window x:Class="SlotMachine_P.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlotMachine" Height="350" Width="500"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <StackPanel Margin="10">

        <TextBlock x:Name="BalanceText" Text="Egyenleg: 1000" FontSize="16" Margin="0,0,0,10"/>
        <TextBlock Text="Szimbólumok száma:" FontWeight="Bold" />

        <RadioButton x:Name="Radio3" Content="3 szimbólum"  Checked="Radio_Checked" IsChecked="True"/>
        <RadioButton x:Name="Radio5" Content="5 szimbólum" Checked="Radio_Checked" IsChecked="False"/>

        <TextBlock x:Name="CostText" Text="Pörgetés ára: 50" Margin="0,10,0,0" />
        <Button x:Name="SpinButton" Content="Pörgetés" Click="SpinButton_Click" Margin="0,10,0,0"/>

        <StackPanel x:Name="ReelsPanel" Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center"/>

    </StackPanel>
</Window>
