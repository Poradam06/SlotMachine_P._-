<Window x:Class="SlotMachine_P.SpinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pörgetés" Height="300" Width="400">

    <StackPanel Margin="10">

        <TextBlock x:Name="BalanceText"
                   FontSize="16"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

        <StackPanel x:Name="ReelsPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20"/>

        <TextBlock x:Name="ResultText"
                   FontSize="20"
                   Margin="10"
                   TextAlignment="Center"/>
        <Button x:Name="NewSpin" Content="Új pörgetés"
                Click="NewSpin_Click"
                HorizontalAlignment="Center" Width="111"
                />
        <CheckBox x:Name="ContinueCheck" Content="Folytatás" Width="77" IsChecked="True" Background="White" Checked="ContCheck" IsEnabled="false"/>
        <Button Content="Vissza a főmenübe"
                Click="BackButton_Click"
                Margin="0,20,0,0"
                HorizontalAlignment="Center" Width="111"/>


    </StackPanel>
</Window>
